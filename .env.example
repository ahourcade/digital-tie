# Copiar como .env y completar antes de publicar.
SITE_URL=https://digitaltie.net
# Endpoint que recibe el formulario (POST JSON). Ej.: https://formspree.io/f/XXXX o un endpoint propio.
# Si queda vacío, el formulario abre el correo del usuario con la consulta armada (no simula envíos).
PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/ahourcade@digitaltie.net
# Correo comercial (a confirmar)
PUBLIC_CONTACT_EMAIL=ahourcade@digitaltie.net
# WhatsApp en formato internacional sin + ni espacios (ej. 5491100000000). Vacío = no se muestra.
PUBLIC_WHATSAPP=5491131190914
# Google Tag Manager (GTM-XXXX). Vacío = no se carga ningún script de analítica ni banner.
PUBLIC_GTM_ID=
