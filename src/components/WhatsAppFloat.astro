---
import { SITE } from '../data/site';
const href = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`;
---
{SITE.whatsapp && (
  <a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp" data-track="click_whatsapp" data-track-label="boton-flotante" data-noprint>
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M16.04 3C8.86 3 3.03 8.82 3.03 15.99c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75a12.97 12.97 0 0 0 6.36 1.62h.01c7.17 0 13-5.83 13-13S23.21 3 16.04 3Zm0 23.68h-.01a10.8 10.8 0 0 1-5.5-1.5l-.4-.24-3.96 1.04 1.06-3.86-.26-.4a10.7 10.7 0 0 1-1.65-5.73c0-5.95 4.85-10.79 10.82-10.79 2.89 0 5.6 1.13 7.64 3.17a10.72 10.72 0 0 1 3.16 7.63c0 5.96-4.85 10.8-10.9 10.8Zm5.92-8.08c-.32-.16-1.92-.95-2.22-1.06-.3-.11-.51-.16-.73.16-.21.32-.84 1.06-1.03 1.27-.19.22-.38.24-.7.08-.32-.16-1.37-.5-2.6-1.6-.96-.86-1.61-1.92-1.8-2.24-.19-.32-.02-.5.14-.66.15-.14.32-.38.48-.57.16-.19.21-.32.32-.54.11-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.86.4-.3.32-1.13 1.1-1.13 2.69s1.16 3.12 1.32 3.34c.16.21 2.27 3.47 5.5 4.87.77.33 1.37.53 1.84.68.77.25 1.47.21 2.03.13.62-.09 1.92-.78 2.19-1.54.27-.75.27-1.4.19-1.53-.08-.14-.3-.22-.62-.38Z"/>
    </svg>
    <span class="wa-label">WhatsApp</span>
  </a>
)}
<style>
  .wa {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 55;
    display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 18px 0 14px;
    border-radius: 999px; background: #25d366; color: #0c1525; text-decoration: none; font-weight: 700; font-size: .9375rem;
    box-shadow: 0 8px 24px -8px rgba(12, 21, 37, .45), 0 0 0 1px rgba(12, 21, 37, .06);
    transition: transform var(--t) var(--ease), box-shadow var(--t) var(--ease);
  }
  .wa:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -8px rgba(12, 21, 37, .5); }
  .wa:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  :global(html.menu-open) .wa { display: none; }
  @media (max-width: 767px) {
    .wa { width: 56px; height: 56px; padding: 0; justify-content: center; }
    .wa-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) { .wa:hover { transform: none; } }
</style>
