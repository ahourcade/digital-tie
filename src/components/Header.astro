---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href) && !(href === '/servicios/' && path.startsWith('/servicios/produccion-de-contenidos/')));
---
<header class:list={['site-header', `tone-${tone}`]}>
  <div class="container bar">
    <a href="/" class="brand" aria-label="Digital Tie — Inicio">
      <Logo variant={tone === 'dark' ? 'white' : 'ink'} class="brand-logo brand-logo--tone" />
      <Logo variant="ink" class="brand-logo brand-logo--scrolled" title="" />
    </a>
    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/contacto/" class="btn cta" data-track="cta_contact" data-track-label="header">Hablemos <span class="arrow" aria-hidden="true">→</span></a>
    <button class="menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span class="menu-label" aria-hidden="true">Menú</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="container" aria-label="Menú móvil">
      <ul role="list">
        {NAV.map((item, i) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><span class="label">0{i + 1}</span>{item.label}</a></li>
        ))}
        <li><a href="/contacto/"><span class="label">05</span>Contacto</a></li>
      </ul>
      <div class="mobile-foot">
        <a class="btn btn--primary" href="/contacto/" data-track="cta_contact" data-track-label="menu">Hablemos <span class="arrow" aria-hidden="true">→</span></a>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    background: color-mix(in srgb, var(--paper) 0%, transparent);
    transition: background var(--t) var(--ease), box-shadow var(--t) var(--ease), color var(--t) var(--ease);
  }
  .site-header.tone-dark { color: #fff; }
  .site-header.is-scrolled, :global(.menu-open) .site-header {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px); backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 var(--line); color: var(--ink);
  }
  .bar { height: 100%; display: flex; align-items: center; gap: var(--s-6); }
  .brand { display: inline-flex; align-items: center; padding: 10px 0; margin-right: auto; position: relative; }
  .brand :global(.brand-logo) { height: 17px; }
  .brand :global(.brand-logo--scrolled) { position: absolute; left: 0; opacity: 0; }
  .tone-dark.is-scrolled .brand :global(.brand-logo--tone),
  :global(.menu-open) .tone-dark .brand :global(.brand-logo--tone) { opacity: 0; }
  .tone-dark.is-scrolled .brand :global(.brand-logo--scrolled),
  :global(.menu-open) .tone-dark .brand :global(.brand-logo--scrolled) { opacity: 1; }
  .tone-light .brand :global(.brand-logo--scrolled) { display: none; }

  .nav ul { display: flex; gap: clamp(1rem, 2.2vw, 2.25rem); margin: 0; }
  .nav a {
    position: relative; text-decoration: none; font-weight: 600; font-size: .9375rem; padding: 10px 0;
    letter-spacing: -0.005em;
  }
  .nav a::after {
    content: ''; position: absolute; left: 50%; bottom: 2px; width: 8px; height: 5px;
    background: var(--blue); clip-path: polygon(0 0, 100% 0, 82% 100%, 18% 100%);
    transform: translateX(-50%) scale(0); transition: transform var(--t) var(--ease);
  }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: translateX(-50%) scale(1); }
  .cta { min-height: 42px; padding: .6em 1.15em; font-size: .9375rem; }
  .tone-dark:not(.is-scrolled) .cta { --btn-bg: #fff; --btn-fg: var(--ink); --btn-bd: #fff; }
  .tone-dark:not(.is-scrolled) .cta:hover { --btn-bg: var(--blue); --btn-fg: #fff; --btn-bd: var(--blue); }

  .menu-btn {
    display: none; align-items: center; gap: 10px; min-height: 44px; padding: 0 2px 0 12px;
    background: none; border: 0; font-weight: 700; font-size: .9375rem;
  }
  .menu-icon { position: relative; width: 22px; height: 12px; display: inline-block; }
  .menu-icon span { position: absolute; left: 0; right: 0; height: 2px; background: currentColor; transition: transform var(--t) var(--ease), top var(--t) var(--ease); }
  .menu-icon span:first-child { top: 0; }
  .menu-icon span:last-child { top: 10px; }
  .menu-btn[aria-expanded='true'] .menu-icon span:first-child { top: 5px; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-icon span:last-child { top: 5px; transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0 0; background: var(--paper); color: var(--ink);
    overflow-y: auto; padding-block: var(--s-6) var(--s-8);
  }
  .mobile-menu ul { margin: 0; border-top: 1px solid var(--line); }
  .mobile-menu li { border-bottom: 1px solid var(--line); }
  .mobile-menu li a {
    display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0; text-decoration: none;
    font-size: clamp(1.75rem, 7vw, 2.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1;
  }
  .mobile-menu li a[aria-current='page'] { color: var(--blue); }
  .mobile-foot { display: grid; gap: var(--s-5); margin-top: var(--s-7); justify-items: start; }
  .mobile-foot .mail { font-weight: 600; color: var(--muted); }
  :global(html.menu-open) { overflow: hidden; }

  @media (max-width: 959px) {
    .nav, .cta { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (min-width: 960px) { .mobile-menu { display: none !important; } }
</style>
