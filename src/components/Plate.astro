---
/**
 * «Placa» editorial: el trabajo real sobre un fondo neutro.
 * - fit="contain": la imagen nunca se recorta ni se agranda más allá de su ancho real.
 * - fit="cover": llena la placa (solo para capturas con resolución suficiente).
 */
import { Image } from 'astro:assets';
import { img, widthsFor } from '../lib/images';
interface Props {
  src: string; alt: string;
  plate?: 'mist' | 'ink' | 'white' | 'sand';
  fit?: 'cover' | 'contain';
  ratio?: string; // ej. '3 / 2'
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { src, alt, plate = 'mist', fit = 'contain', ratio = '3 / 2', sizes = '(min-width: 1024px) 60vw, 100vw', priority = false, class: cls } = Astro.props;
const meta = img(src);
---
<div class:list={['plate', `plate--${plate}`, `fit-${fit}`, cls]} style={`--ratio:${ratio};--nat:${meta.width}px`}>
  <span class="pic"><Image
    src={meta}
    alt={alt}
    widths={widthsFor(meta)}
    sizes={sizes}
    format="webp" quality={82}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  /></span>
</div>
<style>
  .plate { position: relative; aspect-ratio: var(--ratio); overflow: hidden; border-radius: var(--radius); isolation: isolate; }
  .plate--mist { background: var(--mist); }
  .plate--ink { background: #0a111d; }
  .plate--white { background: #fff; box-shadow: inset 0 0 0 1px var(--line); }
  .plate--sand { background: #efece6; }
  .plate .pic { position: absolute; inset: 0; display: grid; place-items: center; }
  .fit-cover :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .fit-contain .pic { padding: clamp(14px, 6%, 56px); }
  .fit-contain :global(img) {
    width: auto; height: auto; max-width: min(100%, var(--nat)); max-height: 100%; object-fit: contain;
    box-shadow: 0 1px 2px rgba(12,21,37,.06), 0 12px 32px -12px rgba(12,21,37,.18);
  }
  .plate--white.fit-contain :global(img), .plate--ink.fit-contain :global(img) { box-shadow: none; }
  :global(.plate img) { transition: transform var(--t-slow) var(--ease); }
</style>
