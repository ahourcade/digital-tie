---
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Consent from '../components/Consent.astro';
import { SITE } from '../data/site';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  image?: string; // ruta absoluta o relativa al sitio (OG)
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  headerTone?: 'light' | 'dark';
}
const { title, description, image = '/og/og-default.jpg', type = 'website', schema = [], breadcrumbs, noindex = false, headerTone = 'light' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const fullTitle = title.includes('Digital Tie') ? title : `${title} — Digital Tie`;

const ld: Record<string, unknown>[] = [...schema];
if (breadcrumbs?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Inicio', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href,
    })),
  });
}
---
<!doctype html>
<html lang="es-AR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Digital Tie" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <script is:inline>document.documentElement.classList.replace('no-js','js');window.dataLayer=window.dataLayer||[];</script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header tone={headerTone} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    {SITE.gtmId && <Consent gtmId={SITE.gtmId} />}
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>
