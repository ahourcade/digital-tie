---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PROJECTS, CATEGORIES } from '../../data/projects';

const main = PROJECTS;
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.key, PROJECTS.filter((p) => p.categories.includes(c.key)).length]));
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Proyectos de Digital Tie',
  hasPart: PROJECTS.map((p) => ({ '@type': 'CreativeWork', name: `${p.client} — ${p.headline}`, url: new URL(`/proyectos/${p.slug}/`, Astro.site).href })),
}];
---
<Base
  title="Proyectos — Portfolio de branding, web, e-commerce y contenidos"
  description={`Portfolio de Digital Tie: ${PROJECTS.length} proyectos reales de branding, sitios web, e-commerce, producción de contenidos y campañas.`}
  breadcrumbs={[{ name: 'Proyectos', href: '/proyectos/' }]}
  schema={schema}
>
  <section class="intro container">
    <p class="label">Portfolio</p>
    <h1 class="display">Proyectos<span class="knot" aria-hidden="true"></span></h1>
    <p class="lead muted">Sitios, tiendas online, identidades, contenidos y campañas para empresas y marcas. Todo lo que ves acá es trabajo real, con su material original.</p>
  </section>

  <section class="container work" aria-label="Listado de proyectos">
    <div class="toolbar" role="search">
      <div class="filters" role="group" aria-label="Filtrar por disciplina">
        <button type="button" class="filter" data-filter="all" aria-pressed="true">Todos <span class="c num">{PROJECTS.length}</span></button>
        {CATEGORIES.map((c) => (
          <button type="button" class="filter" data-filter={c.key} aria-pressed="false">{c.label} <span class="c num">{counts[c.key]}</span></button>
        ))}
      </div>
      <div class="search">
        <label for="q" class="visually-hidden">Buscar por cliente o industria</label>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8"/></svg>
        <input id="q" type="search" placeholder="Buscar cliente o industria" autocomplete="off" />
      </div>
    </div>
    <p class="status small muted" id="status" role="status" aria-live="polite">Mostrando {PROJECTS.length} proyectos</p>

    <ul class="grid" role="list" data-group="main">
      {main.map((p, i) => <li data-item><ProjectCard project={p} size="md" headingLevel="h2" priority={i < 3} /></li>)}
    </ul>

    <div class="empty" hidden data-empty>
      <p class="h3">No encontramos proyectos con esa búsqueda.</p>
      <p class="muted">Probá con otro nombre o volvé a ver todo el portfolio.</p>
      <button type="button" class="btn btn--ghost" data-reset>Ver todos los proyectos</button>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .intro { padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3.5rem); display: grid; gap: var(--s-5); }
  .intro .lead { max-width: 46ch; }
  .toolbar { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding-block: 18px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); position: sticky; top: var(--header-h); background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: 5; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
    border: 1px solid var(--line-strong); background: transparent; font-weight: 600; font-size: .9375rem;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .filter:hover { border-color: var(--ink); }
  .filter[aria-pressed='true'] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .c { font-size: .75rem; color: var(--muted); }
  .filter[aria-pressed='true'] .c { color: #b8c1cf; }
  .search { position: relative; display: flex; align-items: center; flex: 1 1 240px; max-width: 340px; }
  .search svg { position: absolute; left: 14px; color: var(--muted); }
  .search input { width: 100%; min-height: 44px; padding: 0 14px 0 40px; border-radius: 999px; border: 1px solid var(--line-strong); background: #fff; font-size: 1rem; }
  .search input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0,102,255,.18); }
  .status { padding-block: 18px 28px; }
  .grid { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem) var(--gap); grid-template-columns: 1fr; margin: 0; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } .grid--archive { grid-template-columns: repeat(4, 1fr); } }
  .archive { margin-top: var(--section); }
  .archive-head { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; padding-top: 16px; border-top: 1px solid var(--ink); margin-bottom: var(--s-7); }
  .empty { display: grid; gap: 14px; justify-items: start; padding-block: var(--s-8); }
  [data-item][hidden], [data-archive][hidden] { display: none; }
  .work { padding-bottom: var(--section); }
  @media (max-width: 767px) {
    .toolbar { position: static; }
    .filters { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .filter { flex: none; }
    .search { max-width: none; }
  }
</style>

<script>
  import { track } from '../../scripts/analytics';
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
  const q = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
  let cat = 'all';

  const apply = (push = true) => {
    const term = norm(q.value);
    let n = 0;
    for (const li of items) {
      const card = li.querySelector<HTMLElement>('[data-card]')!;
      const okCat = cat === 'all' || card.dataset.cats!.split(' ').includes(cat);
      const okQ = !term || card.dataset.name!.includes(term);
      const show = okCat && okQ;
      li.hidden = !show;
      if (show) n++;
    }
    empty.hidden = n > 0;
    const label = buttons.find((b) => b.dataset.filter === cat)?.firstChild?.textContent?.trim();
    status.textContent = n === 0 ? 'No hay proyectos que coincidan.' : `Mostrando ${n} ${n === 1 ? 'proyecto' : 'proyectos'}${cat !== 'all' ? ` de ${label}` : ''}${term ? ` para «${q.value.trim()}»` : ''}`;
    if (push) {
      const url = new URL(location.href);
      cat === 'all' ? url.searchParams.delete('cat') : url.searchParams.set('cat', cat);
      term ? url.searchParams.set('q', q.value.trim()) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
  };
  const setCat = (c: string) => {
    cat = buttons.some((b) => b.dataset.filter === c) ? c : 'all';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
  };
  buttons.forEach((b) => b.addEventListener('click', () => { setCat(b.dataset.filter!); apply(); track('filter_projects', { label: cat }); }));
  let t: number | undefined;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => apply(), 120); });
  document.querySelector('[data-reset]')?.addEventListener('click', () => { q.value = ''; setCat('all'); apply(); q.focus(); });

  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  setCat(params.get('cat') || 'all');
  apply(false);
</script>
