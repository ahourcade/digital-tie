---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { METHOD } from '../data/site';

const principles = [
  { t: 'Objetivos antes que piezas', d: 'Antes de diseñar, acordamos qué tiene que pasar en el negocio. Eso ordena todo lo demás.' },
  { t: 'Procesos claros', d: 'Etapas, responsables y entregables definidos. Sabés qué estamos haciendo y qué viene después.' },
  { t: 'Creatividad con criterio', d: 'Buscamos ideas que se recuerden, pero que también se puedan producir, publicar y medir.' },
  { t: 'Cercanía', d: 'Trato directo con quienes hacen el trabajo. Sin capas intermedias.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Nosotros — Digital Tie', url: new URL('/nosotros/', Astro.site).href }];
---
<Base
  title="Nosotros — Método corporativo, ejecución creativa"
  description="Digital Tie es una agencia y consultora de marketing digital con más de diez años. Sus fundadores vienen de entornos corporativos como Accenture y Procter & Gamble."
  breadcrumbs={[{ name: 'Nosotros', href: '/nosotros/' }]}
  schema={schema}
>
  <section class="intro container">
    <p class="label">Nosotros</p>
    <h1 class="display">El nudo entre método y <span class="nowrap">creatividad<span class="knot" aria-hidden="true"></span></span></h1>
  </section>

  <section class="container story section--tight">
    <div class="col-a">
      <p class="label">Por qué Digital Tie</p>
    </div>
    <div class="col-b stack-lg">
      <p class="lead-xl">«Tie» es corbata. La elegimos porque resume lo que somos: el vínculo entre el pensamiento corporativo —procesos, profesionalismo, foco en el negocio— y la creatividad, la agilidad y la ejecución digital.</p>
      <p class="lead muted">Somos una agencia y consultora de marketing digital con más de diez años en el mercado. Antes de fundar Digital Tie, sus fundadores trabajaron en entornos corporativos como Accenture y Procter &amp; Gamble. De esa experiencia traemos la forma de trabajar: objetivos claros, procesos ordenados y seguimiento.</p>
      <p class="lead muted">Hoy acompañamos a empresas, marcas y pymes de Argentina y la región con estrategia, branding, sitios web, e-commerce, producción de contenidos y campañas. Pensamos, diseñamos e implementamos con el mismo equipo.</p>
      <p class="small muted">Accenture y Procter &amp; Gamble son antecedentes profesionales de los fundadores; no son clientes de la agencia.</p>
    </div>
  </section>

  <section class="section surface-dark band" aria-label="Lema">
    <div class="container">
      <p class="motto">Corporate mindset.<br /><span>Creative execution.</span><br />Digital growth.</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="method-title">
    <div class="head">
      <p class="label">Método</p>
      <h2 id="method-title" class="h2">Cómo trabajamos.</h2>
      <p class="lead muted">Un proceso simple que aplicamos a cada proyecto, del más chico al más grande. No es una metodología certificada: es la forma ordenada en la que nos gusta trabajar.</p>
    </div>
    <ol class="method" role="list">
      {METHOD.map((m) => (
        <li data-reveal><span class="mn num">{m.n}</span><h3 class="h3">{m.title}</h3><p class="muted">{m.text}</p></li>
      ))}
    </ol>
  </section>

  <section class="section surface-white" aria-labelledby="pr-title">
    <div class="container pr-grid">
      <div class="head">
        <p class="label">Principios</p>
        <h2 id="pr-title" class="h2">Lo que no negociamos.</h2>
      </div>
      <ul class="pr" role="list">
        {principles.map((p) => <li data-reveal><h3 class="h4">{p.t}</h3><p class="muted">{p.d}</p></li>)}
      </ul>
    </div>
  </section>

  <CtaBand title="Conozcámonos. <em>Contanos tu desafío.</em>" />
</Base>

<style>
  .intro { padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) var(--s-8); display: grid; gap: var(--s-5); }
  .intro h1 { max-width: 13ch; }
  .story { display: grid; gap: var(--s-6); padding-bottom: var(--section); }
  .col-a .label { padding-top: 12px; border-top: 1px solid var(--ink); }
  .lead-xl { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; max-width: 30ch; }
  .col-b .lead { max-width: 52ch; }
  @media (min-width: 1024px) { .story { grid-template-columns: repeat(12, 1fr); column-gap: var(--gap); } .col-a { grid-column: 1 / span 3; } .col-b { grid-column: 5 / span 8; } }
  .motto { font-size: clamp(2.5rem, 1rem + 6vw, 7rem); font-weight: 750; letter-spacing: -0.045em; line-height: 1; }
  .motto span { color: var(--blue-on-dark); }
  .head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); max-width: 48rem; }
  .method { display: grid; margin: 0; border-top: 1px solid var(--ink); }
  .method li { display: grid; gap: 10px; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .mn { font-size: clamp(2.5rem, 2rem + 2vw, 4rem); font-weight: 750; color: var(--blue); letter-spacing: -0.05em; line-height: 1; }
  @media (min-width: 900px) {
    .method { grid-template-columns: repeat(4, 1fr); column-gap: var(--gap); border-top: 0; }
    .method li { border-top: 1px solid var(--ink); border-bottom: 0; align-content: start; }
  }
  .pr-grid { display: grid; gap: var(--s-6); }
  .pr { display: grid; margin: 0; border-top: 1px solid var(--ink); }
  .pr li { display: grid; gap: 8px; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .pr { grid-template-columns: 1fr 1fr; column-gap: var(--gap); } .pr-grid { grid-template-columns: 5fr 7fr; column-gap: calc(var(--gap) * 2); } }
</style>
